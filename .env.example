# Copy to .env for local development. Real environment variables always win,
# so a shell export overrides this file without editing it.
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
PROSPECT_DB_PATH=./prospect.db

# HTTP response cache lives in its own file, so `rm cache.db` to force a
# refetch can never touch prospect data.
PROSPECT_CACHE_DB_PATH=./cache.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
PROSPECT_LOG_LEVEL=info     # debug | info | warn | error
PROSPECT_LOG_FORMAT=text    # text for a terminal, json for cron on the VPS

# ---------------------------------------------------------------------------
# Crawling — required for `enrich`
# ---------------------------------------------------------------------------
# Embedded in the User-Agent of every outbound request, so an operator who
# sees the crawler in their logs can reach a human. Required: there is no
# anonymous fallback, and `enrich` refuses to start without it.
PROSPECT_USER_AGENT_EMAIL=you@example.com

PROSPECT_HTTP_TIMEOUT=15s
PROSPECT_CACHE_TTL=168h     # 7 days
PROSPECT_WORKERS=5
PROSPECT_RATE_PER_HOST=1s   # at most one request per second per host

# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------
PROSPECT_WEIGHTS_PATH=./weights.yaml

# ---------------------------------------------------------------------------
# Google Places (optional) — https://console.cloud.google.com/
# Leave unset and `discover` reports the source as disabled and exits cleanly.
# Everything except `discover` works without it.
# ---------------------------------------------------------------------------
# GOOGLE_PLACES_API_KEY=

# THE SWITCH THAT COSTS MONEY. While false, no ceiling may exceed the free
# monthly allowance, whatever else is set below — so the tool cannot produce a
# bill. Set it to true only when you have decided to pay.
PROSPECT_ALLOW_PAID_APIS=false

# Absolute per-SKU ceiling on billable calls per calendar month.
# 0 = derive it from each SKU's free allowance, which is the safe default.
# Any value above the free allowance is CLAMPED unless ALLOW_PAID_APIS is true.
#
# Free allowances are per SKU per month: Essentials 10,000, Pro 5,000,
# Enterprise 1,000. `discover` needs places.websiteUri, an Enterprise field,
# so it bills at Text Search Enterprise: 1,000 free calls per month.
PROSPECT_PLACES_MONTHLY_MAX=0

# Fraction of the free allowance this tool will actually use. The local counter
# can drift below Google's — retries, another machine sharing the key, other
# usage on the same Cloud project — so stopping at 90% is what makes "free"
# actually hold. Effective ceiling for discover: 1000 * 0.9 = 900 calls/month.
PROSPECT_QUOTA_SAFETY_MARGIN=0.9

# Run `prospect quota` to see usage against these ceilings.
# Also set per-API quotas in the Cloud Console: budget alerts notify after the
# fact and do NOT stop usage. See the README.

# ---------------------------------------------------------------------------
# Meta Ad Library (optional, off by default)
# Coverage of non-EU commercial ads is unreliable, so the ad signal is
# primarily recorded by hand:
#   prospect signal <id> --type running_ads --value true
# ---------------------------------------------------------------------------
PROSPECT_ENABLE_META_ADS=false
# META_ADS_ACCESS_TOKEN=
